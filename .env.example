# Только frontend — скопировать в .env (уже в .gitignore).
# Backend в текущем репозитории отсутствует; для автономного демо оставить true.
#
# true  — API-клиент использует заглушки из src/lib/inspection.ts, без сервера.
# false — HTTP-запросы к отдельному сервису по docs/API_CONTRACT.md после его реализации.
# Только точная строка false отключает mock-ветки; после изменения перезапустить Vite.
# Страницы Defects/Users и вход пока не подключены к API: одного флага недостаточно.
VITE_USE_MOCK_API=true

# Публичный адрес будущего API, без суффикса /api. В mock-режиме не используется.
VITE_API_BASE_URL=http://127.0.0.1:8000

# VITE_* попадают в клиентскую сборку. Не добавлять сюда ключи LLM/S3,
# реальные пароли, токены или другие секреты; серверные настройки хранить отдельно.
