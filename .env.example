# Скопировать в .env (файл в .gitignore). После изменений перезапустить Vite.
#
# true  - API-клиент использует заглушки из src/lib/inspection.ts, сервер не нужен.
# false - запросы идут на бэкенд (ветка feat/android-backend). Только точная строка false.
VITE_USE_MOCK_API=true

# Адрес API без суффикса /api. С бэкендом в dev-режиме: /front
# (vite.config.ts проксирует /front и /static на http://127.0.0.1:8000).
VITE_API_BASE_URL=http://127.0.0.1:8000

# VITE_* попадают в клиентскую сборку. Не добавлять сюда ключи LLM, SMTP-пароли
# и другие секреты: серверные настройки хранятся отдельно.
