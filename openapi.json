              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_inspect_equipment_api_inspect_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Файл изображения (.jpg, .png, .webp) для детекции дефектов"
          },
          "equipment_id": {
            "type": "string",
            "title": "Equipment Id",
            "description": "ID оборудования в системе ТОиР",
            "examples": [
              "pump_d1250_03"
            ]
          }
        },
        "type": "object",
        "required": [
          "file",
          "equipment_id"
        ],
        "title": "Body_inspect_equipment_api_inspect_post"
      },
      "ComponentSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "ID узла агрегата",
            "examples": [
              "comp_rotor_01"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Наименование узла агрегата",
            "examples": [
              "Ротор турбины"
            ]
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Тип узла",
            "examples": [
              "Вращающийся механизм"
            ]
          },
          "installation_date": {
            "type": "string",
            "title": "Installation Date",
            "description": "Дата монтажа узла (ГГГГ-ММ-ДД)",
            "examples": [
              "2021-04-12"
            ]
          },
          "age_months": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Age Months",
            "description": "Возраст узла в месяцах",
            "examples": [
              66
            ]
          },
          "criticality_factor": {
            "type": "number",
            "title": "Criticality Factor",
            "description": "Коэффициент ответственности узла (0.5 - 2.0)",
            "default": 1.0,
            "examples": [
              1.5
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "installation_date",
          "age_months"
        ],
        "title": "ComponentSchema"
      },
      "CriticalityLevel": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "CriticalityLevel"
      },
      "DefectCategory": {
        "type": "string",
        "enum": [
          "corrosion",
          "welding_defect",
          "crack",
          "unknown"
        ],
        "title": "DefectCategory"
      },
      "DefectItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Уникальный идентификатор обнаруженного дефекта",
            "examples": [
              "defect_1"
            ]
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Наименование дефекта (Rust, Bad Weld, copper corrosion, etc.)",
            "examples": [
              "corrosion",
              "Bad Weld"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/DefectCategory",
            "description": "Категория дефекта: corrosion (коррозия) или welding_defect (сварной шов/трещина)",
            "examples": [
              "corrosion"
            ]
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Уверенность модели в детекции от 0.0 до 1.0",
            "examples": [
              0.92
            ]
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox",
            "description": "Координаты бокса в пикселях: [x_min, y_min, x_max, y_max]",
            "examples": [
              [
                120.5,
                84.0,
                310.2,
                450.8
              ]
            ]
          },
          "bbox_normalized": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox Normalized",
            "description": "Координаты бокса, нормализованные от 0.0 до 1.0: [x_min, y_min, x_max, y_max]",
            "examples": [
              [
                0.12,
                0.08,
                0.31,
                0.45
              ]
            ]
          },
          "polygon": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Polygon",
            "description": "Массив точек [x, y] контура маски сегментации в нормализованных координатах [0.0 - 1.0]",
            "examples": [
              [
                [
                  0.12,
                  0.08
                ],
                [
                  0.15,
                  0.12
                ],
                [
                  0.22,
                  0.25
                ],
                [
                  0.31,
                  0.45
                ],
                [
                  0.12,
                  0.08
                ]
              ]
            ]
          },
          "model_source": {
            "type": "string",
            "title": "Model Source",
            "description": "Название исходной нейросети",
            "examples": [
              "Decizez/yolov-corrosion-detection",
              "avinashhm/welding-defect-yolov8-full-training"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "category",
          "confidence",
          "bbox",
          "bbox_normalized",
          "model_source"
        ],
        "title": "DefectItem"
      },
      "EquipmentCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Наименование оборудования",
            "examples": [
              "Насос сетевой центробежный 1Д1250-125"
            ]
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number",
            "description": "Заводской серийный номер",
            "examples": [
              "SN-2019-9482-B"
            ]
          },
          "location": {
            "type": "string",
            "title": "Location",
            "description": "Цех / Участок / Место установки",
            "examples": [
              "Цех №3, насосная станция оборотного водоснабжения"
            ]
          },
          "installation_date": {
            "type": "string",
            "title": "Installation Date",
            "description": "Дата ввода в эксплуатацию (ГГГГ-ММ-ДД)",
            "examples": [
              "2019-06-15"
            ]
          },
          "component_age": {
            "type": "string",
            "title": "Component Age",
            "description": "Возраст агрегата/узлов (текст или число лет)",
            "examples": [
              "7 лет 5 месяцев"
            ]
          },
          "last_maintenance_date": {
            "type": "string",
            "title": "Last Maintenance Date",
            "description": "Дата последнего ТО (ГГГГ-ММ-ДД)",
            "examples": [
              "2026-03-20"
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Текущий статус (operational, warning, maintenance, stopped)",
            "default": "operational",
            "examples": [
              "operational"
            ]
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentSchema"
            },
            "type": "array",
            "title": "Components",
            "description": "Список входящих узлов агрегата"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
