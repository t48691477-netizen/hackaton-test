{
  "openapi": "3.1.0",
  "info": {
    "title": "ТОиР Эксперт AI API",
    "description": "Интеллектуальная система предиктивной аналитики и детекции дефектов оборудования (ТОиР). Включает сегментацию очагов коррозии (YOLOv11-seg), детекцию дефектов сварных швов (YOLOv8-det) и генерацию экспертных заключений главного инженера ТОиР на базе LLM.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/equipment": {
      "get": {
        "tags": [
          "Equipment (Оборудование и узлы)"
        ],
        "summary": "Получить список всего оборудования",
        "description": "Возвращает полный реестр агрегатов предприятия со статусами и счетчиком проверок.",
        "operationId": "get_equipment_list_api_equipment_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EquipmentResponse"
                  },
                  "type": "array",
                  "title": "Response Get Equipment List Api Equipment Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Equipment (Оборудование и узлы)"
        ],
        "summary": "Создать или обновить агрегат (для веб-интерфейса)",
        "description": "Создает новую запись об агрегате или обновляет существующую, если передан существующий ID.",
        "operationId": "create_or_update_equipment_api_equipment_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquipmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/equipment/{equipment_id}": {
      "get": {
        "tags": [
          "Equipment (Оборудование и узлы)"
        ],
        "summary": "Получить детальную карточку агрегата",
        "description": "Возвращает подробную карточку конкретного агрегата с узлами, датами ТО и коэффициентами критичности.",
        "operationId": "get_equipment_detail_api_equipment__equipment_id__get",
        "parameters": [
          {
            "name": "equipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Equipment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquipmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/inspect": {
      "post": {
        "tags": [
          "Inspection & AI (Нейросети + LLM)"
        ],
        "summary": "Комплексная инспекция: YOLO (детекция + сегментация) + Эксперт ТОиР (LLM)",
        "description": "Принимает фотографию узла оборудования и его ID. В едином пайплайне выполняет:\n1. Сегментацию очагов коррозии (Decizez/yolov-corrosion-detection) с получением полигонов;\n2. Детекцию дефектов сварных швов и трещин (avinashhm/welding-defect-yolov8-full-training) с получением боксов;\n3. Инженерный анализ Главным экспертом ТОиР (LLM) с расчетом критичности и пошаговыми рекомендациями;\n4. Отрисовку и сохранение аннотированного фото для веб/мобайла.",
        "operationId": "inspect_equipment_api_inspect_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_inspect_equipment_api_inspect_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "tags": [
          "Reports & Dispatcher (Акты осмотра и диспетчеризация)"
        ],
        "summary": "Получить реестр актов осмотра для диспетчера",
        "description": "Возвращает журнал всех актов дефектоскопии и ремонтов. Поддерживает фильтрацию по статусу ремонта и ID оборудования.",
        "operationId": "get_reports_api_reports_get",
        "parameters": [
          {
            "name": "repair_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RepairStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по статусу (pending, in_progress, completed, rejected)",
              "title": "Repair Status"
            },
            "description": "Фильтр по статусу (pending, in_progress, completed, rejected)"
          },
          {
            "name": "equipment_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по идентификатору оборудования",
              "title": "Equipment Id"
            },
            "description": "Фильтр по идентификатору оборудования"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReportResponse"
                  },
                  "title": "Response Get Reports Api Reports Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Reports & Dispatcher (Акты осмотра и диспетчеризация)"
        ],
        "summary": "Сохранить акт осмотра, статус ремонта и итоговое фото",
        "description": "Регистрирует официальный акт осмотра ТОиР с перечнем дефектов, заключением LLM, статусом ремонта и фотоматериалами.",
        "operationId": "create_report_api_reports_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
