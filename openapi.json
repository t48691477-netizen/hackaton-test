            ],
            "title": "Id",
            "description": "Опциональный ID агрегата (если передан, используется для обновления)",
            "examples": [
              "pump_station_3"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "serial_number",
          "location",
          "installation_date",
          "component_age",
          "last_maintenance_date"
        ],
        "title": "EquipmentCreate"
      },
