# Copy to .env, set the real DNS name, and keep the file private.
COMPOSE_PROFILES=cpu
API_UPSTREAM=api:8000
DOMAIN=api.example.com
TOIR_DISABLE_DOCS=true
TOIR_CORS_ORIGINS=
TOIR_DETECT_CONCURRENCY=1
TOIR_DETECT_RATE_LIMIT=30
TOIR_DETECT_RATE_WINDOW_SECONDS=60
TOIR_INGRESS_RATE_LIMIT=120
TOIR_INGRESS_RATE_WINDOW_SECONDS=60

# Generate with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('REPLACE_WITH_A_10_CHARACTER_KEY'))"
TOIR_ACCESS_KEY_HASH=
TOIR_ACCOUNT_ID=emp-001
TOIR_FULL_NAME=Инженер ТОиР
TOIR_EMAIL=engineer@example.com
TOIR_ROLE=engineer

# Optional: when unset, the API uses its local rule-based fallback.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
